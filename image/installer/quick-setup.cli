! quick-setup.cli - the configuration the installer's "quick setup" applies.
! quick_setup.py (called by postinstall.sh) inserts the WAN part
! (quick-setup-wan-dhcp.cli or quick-setup-wan-pppoe.cli) at the WAN_CONFIG line,
! fills in the @...@ placeholders (host name, ports, LAN address/network, NAT
! interface) and feeds this to router-cli. It is the "complete home router"
! recipe from docs/EXAMPLES.md section 7; edit it before building the image to
! change what the quick setup does.
configure terminal
hostname @HOST@
!
!@WAN_CONFIG@
!
interface @LAN@
 description LAN
 ip address @LANIP@ 255.255.255.0
 ip nat inside
 exit
!
access-list 1 permit @NET@.0 0.0.0.255
ip nat inside source list 1 interface @NATIF@ overload
!
ip dhcp excluded-address @NET@.1 @NET@.49
ip dhcp excluded-address @LANIP@
ip dhcp pool LAN
 network @NET@.0 255.255.255.0
 default-router @LANIP@
 dns-server @LANIP@
 exit
!
ip dns server
!
commit comment quick setup by the installer
end
